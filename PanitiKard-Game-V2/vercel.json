{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "installCommand": "npm --prefix server install",
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api/index"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/teacher",
      "destination": "/dashboard"
    },
    {
      "source": "/admin",
      "destination": "/dashboard"
    }
  ]
}
