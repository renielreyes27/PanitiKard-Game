{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "installCommand": "npm --prefix server install",
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/teacher",
      "destination": "/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    }
  ]
}
