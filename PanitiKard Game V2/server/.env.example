# ==============================================================================
# PanitiKard V2 - Server Environment Variables
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ------------------------------------------------------------------------------
# Supabase Configuration (Phase 4 Integration)
# ------------------------------------------------------------------------------
# Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Public/Anon Key (Safe for client and authenticated public queries with RLS)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Secret Key (NEVER expose to client; used strictly by Express backend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Phase 5 Integration)
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Backend-only; never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

